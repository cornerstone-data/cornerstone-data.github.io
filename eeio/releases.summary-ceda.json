{"version":3,"kind":"Article","sha256":"f7b885fe9298c16c171bfc716eeaea7ac1ef9971e8c049b3e1e1730606669d11","slug":"releases.summary-ceda","location":"/releases/summary-ceda.md","dependencies":[],"frontmatter":{"title":"Summary of changes vs. CEDA","authors":[{"nameParsed":{"literal":"Cornerstone Sustainability Data Initiative","given":"Cornerstone Sustainability Data","family":"Initiative"},"name":"Cornerstone Sustainability Data Initiative","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cornerstone-data/eeio-docs","keywords":["EEIO","MRIO","input-output","emission factors","Scope 3","greenhouse gas"],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/cornerstone-data/eeio-docs/blob/main/releases/summary-ceda.md","edit_url":"https://github.com/cornerstone-data/eeio-docs/edit/main/releases/summary-ceda.md","thumbnail":"/eeio/build/summary-vs-ceda-abccddf77fb637e11b1e4d984b55bacf.png","exports":[{"format":"md","filename":"summary-ceda.md","url":"/eeio/build/summary-ceda-862cd4f7efd0a0e38666586d39e58e2c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Summary","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"pvP2ZSKJeT"}],"key":"MxpEgy2gMr"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Cornerstone EEIO 2026 is the continuation of CEDA 2025. For global factors, the net change is on median −23.3% in kg CO₂e per 2024 USD (production-weighted), driven by a combination of data and methodology changes.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Ma9PlvDxEG"}],"key":"arhbqDVt0J"}],"key":"pjDK17SBAA"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/eeio/build/summary-vs-ceda-abccddf77fb637e11b1e4d984b55bacf.png","alt":"Waterfall chart of the global emission factor. From CEDA 2025 at 0.6942, data updates add 5.8% and methodology changes remove 27.5%, ending at 0.5324 for Cornerstone 2026, 23.3% lower.","width":"80%","key":"KngMakbhcj","urlSource":"../images/summary-vs-ceda.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"summary-vs-ceda","identifier":"summary-vs-ceda","html_id":"summary-vs-ceda","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"AL2ycVhy6w"},{"type":"text","value":"1","key":"AsaS6j39IM"},{"type":"text","value":":","key":"N4NhrsTFh4"}],"template":"Figure %s:","key":"OEaDlfpcBU"},{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Cornerstone 2026 against CEDA 2025 (global).","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"bXA4OGpUgR"}],"key":"C9oQiGZwbj"},{"type":"text","value":" Global production-weighted total emission factor, in kg CO₂e per 2024 USD, split into data updates and methodology changes.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"hdcXR6IUea"}],"key":"gkzIG3BoK8"}],"key":"DXbMPveYKw"}],"label":"summary-vs-ceda","identifier":"summary-vs-ceda","enumerator":"1","html_id":"summary-vs-ceda","key":"Pw3cEuJb7Z"},{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Your footprint may not follow the median","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"pUsH00Y3FI"}],"key":"ed2OtyeUoI"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"A company’s change depends on which sectors and countries its spend falls in. A small median can hide large moves in individual sectors, in both directions. From a sample of 400 corporate footprints, the median company will experience a decrease of 14%.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"sqI1pkF2dV"}],"key":"DdL0guJyu2"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/eeio/build/company-footprint-ch-47565b6c5bd344d5bdd9c9947ad69bd7.png","alt":"Histogram of the change in the footprint of 400 companies against CEDA. Nearly all companies decrease, mostly between 0% and 40%, with a median of a 14% decrease. A few companies change by less than 1% or increase slightly.","width":"90%","key":"wUiww21RxX","urlSource":"../images/company-footprint-change-ceda.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"company-footprint-change-ceda","identifier":"company-footprint-change-ceda","html_id":"company-footprint-change-ceda","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"NSzEiLHKzu"},{"type":"text","value":"2","key":"mwwMkcaold"},{"type":"text","value":":","key":"dFJ8Sa7li5"}],"template":"Figure %s:","key":"hV15KGuQod"},{"type":"strong","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Change in the footprint of 400 companies, Cornerstone 2026 against CEDA 2025.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"uVnqBrHBW3"}],"key":"b7RhT6Iw5M"},{"type":"text","value":" Each bar groups companies by the percentage change in their total footprint. Bars outside the shaded ±20% band are in green. Bar heights are approximate.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"yu2wMSEt3w"}],"key":"kivd5U9HtZ"}],"key":"KGZsgqS8gt"}],"label":"company-footprint-change-ceda","identifier":"company-footprint-change-ceda","enumerator":"2","html_id":"company-footprint-change-ceda","key":"ELqW5sYWWj"}],"class":"dropdown","key":"rvu8lRSSRU"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"What drives the change for CEDA users","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"LNeImj3guU"}],"identifier":"what-drives-the-change-for-ceda-users","label":"What drives the change for CEDA users","html_id":"what-drives-the-change-for-ceda-users","implicit":true,"key":"WwzkrqDRg8"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Four changes drive ~95% of the impact: China data, Europe and global data, ABSR and benchmark-informed improvements.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"u0Ats52k5b"}],"key":"t89B3RF8H1"},{"type":"container","kind":"figure","children":[{"type":"iframe","src":"../../interactive/drivers-waterfall.html?d=ceda","width":"100%","key":"kWjTFV1wNe"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"drivers-vs-ceda","identifier":"drivers-vs-ceda","html_id":"drivers-vs-ceda","enumerator":"3","children":[{"type":"text","value":"Figure ","key":"oJxgbmdku2"},{"type":"text","value":"3","key":"QcA1sqN0Vs"},{"type":"text","value":":","key":"ja0VKfsU40"}],"template":"Figure %s:","key":"TRsxPjrTR5"},{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Change in the global production-weighted emission factor from CEDA 2025 to Cornerstone 2026, by driver.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"AVWGEm2EEL"}],"key":"rn5DQBsLrT"},{"type":"text","value":" Percentages are changes relative to the CEDA 2025 baseline. Hover over a bar for details. The vertical axis does not start at zero.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"rH145dx6MC"}],"key":"bL66419alg"}],"key":"FLhRXzW8yI"}],"label":"drivers-vs-ceda","identifier":"drivers-vs-ceda","enumerator":"3","html_id":"drivers-vs-ceda","key":"lJKXtQ9gze"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"New data for China","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"FYEdNUTXmW"}],"identifier":"new-data-for-china","label":"New data for China","html_id":"new-data-for-china","implicit":true,"key":"vyJGVWq1Aj"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Cornerstone adopts the most recent economic data released by the Chinese National Bureau of Statistics (2023 vs. 2020), which reflects methodology changes, changes in the economic structure, and sector-specific decarbonization.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"JjXgH5l7td"}],"key":"FT68LNVQKw"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"For example, China’s battery factor rises by ~30% driven by a change in the composition of battery production in China. From 2020 to 2023, battery production more than tripled, but more importantly it shifted to require more lithium-ion and less lead-acid as inputs. This is because the majority of the market growth in batteries is in EVs and grid storage, which require lithium-ion. Lithium-ion needs lithium chemicals and power-hungry cell factories, being more carbon intensive per dollar than lead-acid batteries, driving the emission factor up.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"ZCekSh95wr"}],"key":"l1mq7ynZkY"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/eeio/build/rc-china-battery-38a6b4efc119093c48e3ea3299becb2c.png","alt":"Stacked bar chart of China battery production. In 2020, output was 382 GWh, mostly lead-acid. In 2023, output was 1,183 GWh, mostly lithium-ion.","width":"65%","key":"KGMgIumSVF","urlSource":"../images/rc-china-battery.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"summary-china-battery","identifier":"summary-china-battery","html_id":"summary-china-battery","enumerator":"4","children":[{"type":"text","value":"Figure ","key":"GEAhuSmuQz"},{"type":"text","value":"4","key":"yrByjLTwlZ"},{"type":"text","value":":","key":"f5Ab7UUJHx"}],"template":"Figure %s:","key":"QCSqw7eBqk"},{"type":"strong","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"China battery production, 2020 and 2023.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"SmMj75pJjr"}],"key":"EjurQqxzhI"},{"type":"text","value":" Output in GWh. The split by battery type is approximate. Sources: NBS input-output tables 2020 and 2023; MIIT; China lead-acid battery industry statistics.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"jdbShWGGbt"}],"key":"RXZRAXQqch"}],"key":"Lg4eJJYp6V"}],"label":"summary-china-battery","identifier":"summary-china-battery","enumerator":"4","html_id":"summary-china-battery","key":"RpfoPQf2t8"},{"type":"heading","depth":3,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"New data for Europe","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"DoLngW0s5A"}],"identifier":"new-data-for-europe","label":"New data for Europe","html_id":"new-data-for-europe","implicit":true,"key":"hE6voHpUmS"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Cornerstone adopts the most recent release of FIGARO, Eurostat’s official input-output and emissions dataset. FIGARO is more granular than the OECD dataset for Europe, is available as a time series through 2023, and is updated every year, matching Cornerstone’s release cadence.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"nONN8nIPdG"}],"key":"qNccFqPcah"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"This data update lowers European factors by about 4% in median. The most significant change is in electricity factors, which fall in every EU country. This change is driven by an increase in renewable energy and by an increase in energy prices due to the gas-supply shocks the Ukraine war has caused in Europe. For example, Germany’s power factor fell by 60%, as renewables grew from 35% to over 50% of generation and wholesale power prices more than doubled.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"xL2dJjF0GH"}],"key":"eSfVOHHzfw"},{"type":"heading","depth":3,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Auto-balanced structural reflection (ABSR)","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"mPWAAbX0F3"}],"identifier":"auto-balanced-structural-reflection-absr","label":"Auto-balanced structural reflection (ABSR)","html_id":"auto-balanced-structural-reflection-absr","implicit":true,"key":"Ify3ovwgSS"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Structural reflection is the method CEDA uses to maintain the same sectoral granularity across all countries.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"OBxjAZPr3x"}],"key":"oB5YOtCWJx"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"The ABSR method is an improvement in this methodology. It achieves two goals that are hard to deliver together in a global model:","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"ogSGtMcmYO"}],"key":"B9dsTxzIT8"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":67,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"All countries share the same 405 sectors, so emission factors compare like for like.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"UhLXJmbxqi"}],"key":"bghdiSyPlT"}],"key":"k9CfJLmqWC"},{"type":"listItem","spread":true,"position":{"start":{"line":68,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Each economy balances production and consumption in terms of monetary transactions and emissions.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"INQyR3dNHh"}],"key":"NGbFaTFT7F"}],"key":"vqRYdsaV3v"}],"key":"bEf9lDcv0U"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/eeio/build/absr-diagram-7c718c8ee889f18f8055bb6fd18e3dca.png","alt":"Diagram of the ABSR method. Countries A, B and C start with different numbers of sectors, so the sector granularity varies by country. ABSR disaggregates and balances each economy, giving every country the same 405 sectors, with row and column totals that check out.","width":"100%","key":"drJfslreYi","urlSource":"../images/absr-diagram.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"absr-diagram","identifier":"absr-diagram","html_id":"absr-diagram","enumerator":"5","children":[{"type":"text","value":"Figure ","key":"Yz1a4FrlhS"},{"type":"text","value":"5","key":"rI08D2SUpV"},{"type":"text","value":":","key":"gMpCRWUXnS"}],"template":"Figure %s:","key":"IVWHEiFjQR"},{"type":"strong","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"How ABSR works.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"E0kx7gVYDX"}],"key":"jsEXb6ljGU"},{"type":"text","value":" ABSR disaggregates each country’s economy into the same 405 sectors and balances it, so that production and consumption match in both money and emissions.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"eKBC9ElfSL"}],"key":"TudyquJ2Vl"}],"key":"aOtMM4qpFs"}],"label":"absr-diagram","identifier":"absr-diagram","enumerator":"5","html_id":"absr-diagram","key":"CJNaCi2crJ"},{"type":"heading","depth":2,"position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Third-party benchmarking","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"xRFglJHYk6"}],"identifier":"third-party-benchmarking","label":"Third-party benchmarking","html_id":"third-party-benchmarking","implicit":true,"key":"WJq3MmFQ8f"},{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Cornerstone uses benchmark data built from about 1,000 sources to review the key sectors that drive about 50% of global emissions. Each review ends in one of three outcomes:","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"Fv1Z1OBhwK"}],"key":"UmrRuOBENc"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":82,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Sharper benchmark.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"SPCUjGJzJd"}],"key":"eojI7M1QZj"},{"type":"text","value":" Scope and price assumptions are aligned, so the external reference is directly comparable to the model.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"DubL8snqMI"}],"key":"CsARqPhJA0"}],"key":"WzD1SXufTv"},{"type":"listItem","spread":true,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Model improvement.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"xLagCqmR8w"}],"key":"M3l9Uw2uPy"},{"type":"text","value":" The gap is traced to a data source or an allocation method, and fixed with more data or a corrected implementation.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"YzW13Rz7SH"}],"key":"vqfXfxB7iR"}],"key":"K8JewGmTLk"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Known discrepancy.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"PToZKSTGJY"}],"key":"n7p6wz6aSw"},{"type":"text","value":" The difference is documented, because of a limitation in how the model is built or a gap in the data.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"aA2OQjV65n"}],"key":"vMoMNKetBF"}],"key":"rVMAZb26gn"}],"key":"mQ34CQQuG8"},{"type":"table","position":{"start":{"line":86,"column":1},"end":{"line":90,"column":1}},"chil